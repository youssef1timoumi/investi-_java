<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.connections3a8.controllers.BadgeController"
      styleClass="root-container"
      stylesheets="@badgesForm.css"
      spacing="20">

    <padding>
        <Insets top="32" right="36" bottom="32" left="36"/>
    </padding>

    <!-- Title -->
    <Label text="Badge Management" styleClass="page-title"/>

    <Separator styleClass="styled-separator"/>

    <!-- Form Fields -->
    <GridPane styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="150" prefWidth="160"/>
            <ColumnConstraints minWidth="300" prefWidth="420" hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Name -->
        <Label text="Badge Name:" styleClass="form-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" promptText="Enter badge name"
                   styleClass="modern-text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <!-- Description -->
        <Label text="Description:" styleClass="form-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextArea fx:id="descriptionArea" promptText="Enter badge description"
                  prefRowCount="3" styleClass="modern-text-area"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <!-- Points Required -->
        <Label text="Points Required:" styleClass="form-label"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="pointsRequiredField" promptText="0"
                   styleClass="modern-text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <!-- Info Label -->
        <Label text="" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label text="Set to 0 for badges earned by actions (not points)"
               styleClass="hint-label" wrapText="true"
               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <Separator styleClass="styled-separator"/>

    <!-- Buttons -->
    <HBox styleClass="button-bar">
        <Button text="Add Badge" onAction="#handleAddBadge"
                styleClass="btn, btn-primary" prefWidth="130"/>
        <Button text="Clear Form" onAction="#handleClearForm"
                styleClass="btn, btn-secondary" prefWidth="130"/>
        <Button text="View All" onAction="#handleViewAll"
                styleClass="btn, btn-secondary" prefWidth="130"/>
        <Button text="Back" onAction="#handleBack"
                styleClass="btn, btn-dark" prefWidth="110"/>
    </HBox>

    <!-- Status Label -->
    <Label fx:id="statusLabel" styleClass="status-label"
           alignment="CENTER" wrapText="true"/>

    <Separator styleClass="styled-separator"/>

    <!-- Badge List -->
    <VBox spacing="12">
        <Label text="Existing Badges" styleClass="section-title"/>

        <ScrollPane fitToWidth="true" prefHeight="220"
                    styleClass="badge-scroll-pane">
            <VBox fx:id="badgeListContainer" styleClass="badge-list-container">
                <!-- Badges will be loaded here dynamically -->
            </VBox>
        </ScrollPane>
    </VBox>

</VBox>
