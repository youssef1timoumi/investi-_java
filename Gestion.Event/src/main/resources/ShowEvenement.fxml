<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ShowEvenementController"
            prefHeight="600.0" prefWidth="1000.0">

    <!-- TITRE -->
    <top>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #1E3A8A; -fx-padding: 20;">
            <Label text="📋 LISTE DES ÉVÉNEMENTS"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- TABLE -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <HBox alignment="CENTER_RIGHT">
                <Button text="➕ Ajouter un événement" onAction="#navAjout"
                        style="-fx-background-color: #10B981; -fx-text-fill: white;
                              -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-height: 40px;"/>
            </HBox>

            <TableView fx:id="tabEvent" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="id_mentorCol" text="ID Mentor" prefWidth="80"/>
                    <TableColumn fx:id="titreCol" text="Titre" prefWidth="150"/>
                    <TableColumn fx:id="contenuCol" text="Contenu" prefWidth="200"/>
                    <TableColumn fx:id="lieuCol" text="Lieu" prefWidth="120"/>
                    <TableColumn fx:id="debCol" text="Date Début" prefWidth="150"/>
                    <TableColumn fx:id="finCol" text="Date Fin" prefWidth="150"/>
                    <TableColumn fx:id="actCol" text="Actions" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
