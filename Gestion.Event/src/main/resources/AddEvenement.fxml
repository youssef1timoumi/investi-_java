<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AddEvenementController"
            prefHeight="500.0" prefWidth="600.0">

    <!-- TITRE -->
    <top>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #1E3A8A; -fx-padding: 20;">
            <Label text="📝 AJOUTER / MODIFIER UN ÉVÉNEMENT"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- FORMULAIRE -->
    <center>
        <VBox spacing="15" style="-fx-padding: 30;">

            <Label text="Titre *" style="-fx-font-weight: bold;"/>
            <TextField fx:id="titre" promptText="Ex: Formation JavaFX"/>

            <Label text="Contenu *" style="-fx-font-weight: bold;"/>
            <TextField fx:id="contenu" promptText="Description de l'événement"/>

            <Label text="Lieu *" style="-fx-font-weight: bold;"/>
            <TextField fx:id="lieu" promptText="Ex: ESPRIT Tunis"/>

            <Label text="ID Mentor *" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="id_mentor" prefWidth="200"/>

            <HBox spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Date Début *" style="-fx-font-weight: bold;"/>
                    <DatePicker fx:id="date_deb"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Date Fin *" style="-fx-font-weight: bold;"/>
                    <DatePicker fx:id="date_fin"/>
                </VBox>
            </HBox>

            <Separator/>

            <HBox spacing="15" alignment="CENTER">
                <Button fx:id="btnAction" text="➕ Ajouter" onAction="#add_evenement"
                        style="-fx-background-color: #1E3A8A; -fx-text-fill: white;
                              -fx-font-weight: bold; -fx-pref-width: 150; -fx-pref-height: 40;"/>
                <Button fx:id="btnAnnuler" text="❌ Annuler" onAction="#annuler"
                        style="-fx-background-color: #6B7280; -fx-text-fill: white;
                              -fx-font-weight: bold; -fx-pref-width: 150; -fx-pref-height: 40;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>