<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="800.0" prefWidth="1200.0" styleClass="card" stylesheets="@shadcn.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ShowProductsController">
   <children>
      <!-- Catalog Header -->
      <VBox styleClass="catalog-header">
         <children>
            <Label styleClass="catalog-title" text="Catalogue de Produits" />
            <Label styleClass="catalog-subtitle" text="Découvrez notre sélection exclusive de produits numériques et physiques" />
         </children>
      </VBox>

      <VBox spacing="20.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         <children>
            <!-- Filters & Actions -->
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <HBox fx:id="filterContainer" alignment="CENTER" spacing="10.0" styleClass="filters-container">
                     <children>
                        <Button fx:id="btnFilterAll" onAction="#handleFilterAll" styleClass="filter-button, active" text="Tous les produits" />
                        <Button fx:id="btnFilterDigital" onAction="#handleFilterDigital" styleClass="filter-button" text="Numériques" />
                        <Button fx:id="btnFilterPhysical" onAction="#handleFilterPhysical" styleClass="filter-button" text="Physiques" />
                        <Button fx:id="btnFilterActive" onAction="#handleFilterActive" styleClass="filter-button" text="Actifs" />
                     </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#navigateAddProduct" styleClass="primary-button" text="+ Add New Product" />
               </children>
            </HBox>

            <!-- Products Grid Container -->
            <StackPane VBox.vgrow="ALWAYS">
               <children>
                  <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                     <content>
                        <TilePane fx:id="productGrid" prefColumns="3" prefTileWidth="320.0" prefTileHeight="450.0" styleClass="product-grid" />
                     </content>
                  </ScrollPane>
                  
                  <!-- Empty State (Hidden by default) -->
                  <VBox fx:id="emptyState" alignment="CENTER" spacing="10.0" visible="false">
                     <children>
                        <Label styleClass="empty-state-title" text="Aucun produit trouvé" />
                        <Label styleClass="empty-state-text" text="Essayez de modifier vos filtres" />
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </VBox>
   </children>
</VBox>
