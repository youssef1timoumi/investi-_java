<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.connexion3a8.controllers.HomeController"
      styleClass="inv-page-body" spacing="48">
    <padding>
        <Insets top="40" right="56" bottom="56" left="56"/>
    </padding>

    <!-- KYC Banners -->
    <HBox fx:id="kycBanner" alignment="CENTER_LEFT" spacing="15" visible="false" managed="false"
          styleClass="inv-banner-warning">
        <Label text="Your account is pending verification. Please upload your ID to use all features."
               styleClass="inv-banner-text" wrapText="true" HBox.hgrow="ALWAYS"/>
        <Button fx:id="uploadIdBtn" text="Upload ID" onAction="#handleUploadId" styleClass="btn-secondary"/>
    </HBox>
    <HBox fx:id="kycPendingBanner" alignment="CENTER_LEFT" spacing="15" visible="false" managed="false"
          styleClass="inv-banner-info">
        <Label text="Your ID has been submitted and is under review. You will be notified once approved."
               styleClass="inv-banner-text" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Invisible legacy admin button (HomeController references it) -->
    <Button fx:id="adminDashboardBtn" visible="false" managed="false" onAction="#handleAdminDashboard"/>

    <!-- Hero -->
    <VBox alignment="CENTER" spacing="18" styleClass="inv-hero">
        <Label text="Where Innovation Meets Investment" styleClass="inv-hero-title" wrapText="true" textAlignment="CENTER"/>
        <Label text="Connect with visionary innovators and strategic investors. Transform groundbreaking ideas into successful ventures."
               styleClass="inv-hero-subtitle" wrapText="true" textAlignment="CENTER"/>
    </VBox>

    <!-- Stats -->
    <HBox alignment="CENTER" spacing="40" styleClass="stats-card">
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="500+" styleClass="stat-number"/>
            <Label text="Active Users" styleClass="stat-label"/>
        </VBox>
        <Separator orientation="VERTICAL" styleClass="inv-stats-divider"/>
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="200+" styleClass="stat-number"/>
            <Label text="Ideas Shared" styleClass="stat-label"/>
        </VBox>
        <Separator orientation="VERTICAL" styleClass="inv-stats-divider"/>
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="150+" styleClass="stat-number"/>
            <Label text="Projects Funded" styleClass="stat-label"/>
        </VBox>
        <Separator orientation="VERTICAL" styleClass="inv-stats-divider"/>
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="300+" styleClass="stat-number"/>
            <Label text="Collaborations" styleClass="stat-label"/>
        </VBox>
    </HBox>

    <!-- How It Works -->
    <VBox spacing="28" alignment="CENTER">
        <VBox alignment="CENTER" spacing="8">
            <Label text="How It Works" styleClass="inv-section-title"/>
            <Label text="Your journey from idea to funded project in four simple steps"
                   styleClass="inv-section-subtitle"/>
        </VBox>
        <GridPane hgap="24" vgap="24" alignment="CENTER">
            <VBox spacing="12" styleClass="step-card" GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="280">
                <Label text="1" styleClass="step-number"/>
                <Label text="Share Your Idea" styleClass="step-title"/>
                <Label text="Post your innovative concept and get feedback from the community"
                       styleClass="step-description" wrapText="true"/>
            </VBox>
            <VBox spacing="12" styleClass="step-card" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="280">
                <Label text="2" styleClass="step-number"/>
                <Label text="Connect" styleClass="step-title"/>
                <Label text="Find investors and collaborators who share your vision"
                       styleClass="step-description" wrapText="true"/>
            </VBox>
            <VBox spacing="12" styleClass="step-card" GridPane.columnIndex="2" GridPane.rowIndex="0" maxWidth="280">
                <Label text="3" styleClass="step-number"/>
                <Label text="Collaborate" styleClass="step-title"/>
                <Label text="Work together to refine and develop your project"
                       styleClass="step-description" wrapText="true"/>
            </VBox>
            <VBox spacing="12" styleClass="step-card" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="280">
                <Label text="4" styleClass="step-number"/>
                <Label text="Launch" styleClass="step-title"/>
                <Label text="Bring your idea to life with funding and support"
                       styleClass="step-description" wrapText="true"/>
            </VBox>
        </GridPane>
    </VBox>

    <!-- CTA -->
    <VBox alignment="CENTER" spacing="14" styleClass="cta-section">
        <Label text="Ready to Start Your Journey?" styleClass="cta-title" textAlignment="CENTER"/>
        <Label text="Join thousands of innovators and investors transforming ideas into reality."
               styleClass="cta-text" textAlignment="CENTER"/>
        <HBox spacing="14" alignment="CENTER">
            <Button text="Browse products" onAction="#handleProducts" styleClass="action-pill"/>
            <Button text="Explore events"   onAction="#handleEvents"   styleClass="action-pill"/>
            <Button text="Join the forum"   onAction="#handleForum"    styleClass="action-pill"/>
        </HBox>
    </VBox>
</VBox>
