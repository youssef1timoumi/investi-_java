<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.connexion3a8.controllers.AdminDashboardController"
      styleClass="inv-page-body" spacing="28">
    <padding>
        <Insets top="36" right="48" bottom="56" left="48"/>
    </padding>

    <!-- Page title -->
    <VBox spacing="6">
        <Label text="Admin Dashboard" styleClass="inv-section-title"/>
        <Label text="Manage users, verify KYC, and oversee the platform." styleClass="inv-section-subtitle"/>
    </VBox>

    <!-- Stats Bar -->
    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS" styleClass="stat-card-blue">
            <Label fx:id="statTotal" text="0" styleClass="stat-number"/>
            <Label text="Total Users" styleClass="stat-label"/>
        </VBox>
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS" styleClass="stat-card-green">
            <Label fx:id="statVerified" text="0" styleClass="stat-number"/>
            <Label text="Verified (Active)" styleClass="stat-label"/>
        </VBox>
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS" styleClass="stat-card-yellow">
            <Label fx:id="statPending" text="0" styleClass="stat-number"/>
            <Label text="Pending KYC" styleClass="stat-label"/>
        </VBox>
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS" styleClass="stat-card-red">
            <Label fx:id="statUnverified" text="0" styleClass="stat-number"/>
            <Label text="Unverified" styleClass="stat-label"/>
        </VBox>
    </HBox>

    <!-- KYC Review Section -->
    <VBox spacing="15" styleClass="glass-card">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="KYC Verification Queue" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#refreshKycTable" styleClass="btn-secondary"/>
        </HBox>

        <Label fx:id="kycEmptyLabel" text="No pending KYC requests"
               styleClass="muted" style="-fx-padding: 20; -fx-alignment: center;"
               visible="false" managed="false"/>

        <TableView fx:id="kycTable" styleClass="data-table" prefHeight="220" minHeight="180">
            <columns>
                <TableColumn fx:id="kycColName" text="Name" prefWidth="150" minWidth="120"/>
                <TableColumn fx:id="kycColEmail" text="Email" prefWidth="220" minWidth="150"/>
                <TableColumn fx:id="kycColRole" text="Role" prefWidth="120" minWidth="80"/>
                <TableColumn fx:id="kycColActions" text="Actions" prefWidth="320" minWidth="280"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Add/Edit User Form -->
    <VBox spacing="20" styleClass="glass-card">
        <Label text="Add / Edit User" styleClass="section-title"/>

        <GridPane hgap="20" vgap="15">
            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-field"/>
            <TextField fx:id="emailField" promptText="user@example.com" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       styleClass="modern-input" GridPane.hgrow="ALWAYS"/>

            <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="label-field"/>
            <TextField fx:id="nameField" promptText="Full Name" GridPane.columnIndex="1" GridPane.rowIndex="1"
                       styleClass="modern-input" GridPane.hgrow="ALWAYS"/>

            <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="label-field"/>
            <PasswordField fx:id="passwordField" promptText="Password" GridPane.columnIndex="1" GridPane.rowIndex="2"
                           styleClass="modern-input" GridPane.hgrow="ALWAYS"/>

            <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="label-field"/>
            <TextField fx:id="roleField" promptText="user, innovator, investor, admin" GridPane.columnIndex="1" GridPane.rowIndex="3"
                       styleClass="modern-input" GridPane.hgrow="ALWAYS"/>

            <Label text="Bio:" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="label-field" GridPane.valignment="TOP"/>
            <TextArea fx:id="bioField" promptText="User bio (optional)" GridPane.columnIndex="1" GridPane.rowIndex="4"
                      styleClass="modern-input" GridPane.hgrow="ALWAYS" prefRowCount="3" wrapText="true"/>
        </GridPane>

        <HBox spacing="15">
            <Button fx:id="btnAdd" text="Save User" onAction="#addUser" styleClass="btn-primary"/>
            <Button fx:id="btnClear" text="Clear" onAction="#handleClear" styleClass="btn-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRefresh" text="Refresh" onAction="#refreshTable" styleClass="btn-secondary"/>
        </HBox>
    </VBox>

    <!-- Users Table -->
    <VBox spacing="15" styleClass="glass-card">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="All Users" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false" prefWidth="30" prefHeight="30"/>
        </HBox>

        <!-- Search + Filter Row -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Search by name, email, or role..." styleClass="modern-input" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="filterCombo" promptText="Filter by status" styleClass="filter-combo" prefWidth="220"/>
        </HBox>

        <Label fx:id="emptyStateLabel" text="No users found."
               styleClass="muted" style="-fx-padding: 40; -fx-alignment: center;"
               visible="false" managed="false"/>

        <Label fx:id="userCountLabel" text="" styleClass="muted"/>

        <TableView fx:id="userTable" styleClass="data-table" prefHeight="500" minHeight="500">
            <columns>
                <TableColumn fx:id="colName" text="Name" prefWidth="160" minWidth="120"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="220" minWidth="150"/>
                <TableColumn fx:id="colRole" text="Role" prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="120" minWidth="100"/>
                <TableColumn fx:id="colPoints" text="Points" prefWidth="80" minWidth="60"/>
                <TableColumn fx:id="colLevel" text="Level" prefWidth="70" minWidth="50"/>
                <TableColumn fx:id="colCreatedAt" text="Joined" prefWidth="140" minWidth="120"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="300" minWidth="260"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Hidden legacy handlers kept so controller doesn't NPE -->
    <Button visible="false" managed="false" onAction="#handleGamification"/>
    <Button visible="false" managed="false" onAction="#handleEventManagement"/>
    <Button visible="false" managed="false" onAction="#handleViewCollaboration"/>
    <Button visible="false" managed="false" onAction="#handleUserManagement"/>
    <Button visible="false" managed="false" onAction="#handleProducts"/>
    <Button visible="false" managed="false" onAction="#handleViewHome"/>
    <Button visible="false" managed="false" onAction="#handleLogout"/>
</VBox>
