<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AddSaleController">
   <content>
      <VBox alignment="CENTER" maxWidth="Infinity" minHeight="600.0" spacing="0" style="-fx-padding: 20;">
         <children>
            <VBox maxWidth="650.0" spacing="30.0" styleClass="form-container">
               <children>
                  <!-- Header -->
                  <VBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label fx:id="titleLabel" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #333;" text="📦 Enregistrer une Vente" />
                        <HBox alignment="CENTER" styleClass="info-banner">
                           <children>
                              <Label style="-fx-text-fill: #555; -fx-font-size: 13;" text="Saisissez les détails de la transaction pour le nouveau dossier de vente" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <VBox spacing="20.0">
                     <children>
                        <!-- Product Selection -->
                        <VBox spacing="8.0">
                           <children>
                              <HBox spacing="5">
                                 <Label styleClass="label-bold" text="Produit à Acheter" />
                                 <Label style="-fx-text-fill: #e74c3c;" text="*" />
                              </HBox>
                              <ComboBox fx:id="productCb" maxWidth="Infinity" promptText="Choisir un produit..." styleClass="combo-box" />
                           </children>
                        </VBox>

                        <!-- Reference and Customer Row -->
                        <GridPane hgap="20.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                           </columnConstraints>
                           <children>
                              <VBox spacing="8.0">
                                 <children>
                                    <HBox spacing="5">
                                       <Label styleClass="label-bold" text="Référence de Commande" />
                                       <Label style="-fx-text-fill: #e74c3c;" text="*" />
                                    </HBox>
                                    <TextField fx:id="refTf" promptText="REF-2024-XXXX" styleClass="custom-text-input" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" GridPane.columnIndex="1">
                                 <children>
                                    <HBox spacing="5">
                                       <Label styleClass="label-bold" text="ID Client" />
                                       <Label style="-fx-text-fill: #e74c3c;" text="*" />
                                    </HBox>
                                    <TextField fx:id="customerTf" promptText="Numéro d'identification client" styleClass="custom-text-input" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>

                        <!-- Amount and Currency Row -->
                        <GridPane hgap="20.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                           </columnConstraints>
                           <children>
                              <VBox spacing="8.0">
                                 <children>
                                    <Label styleClass="label-bold" text="Montant Total" />
                                    <TextField fx:id="amountTf" promptText="0.00" styleClass="custom-text-input" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" GridPane.columnIndex="1">
                                 <children>
                                    <Label styleClass="label-bold" text="Devise" />
                                    <TextField fx:id="currencyTf" text="TND" styleClass="custom-text-input" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>

                        <!-- Order and Payment Status Row -->
                        <GridPane hgap="20.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                           </columnConstraints>
                           <children>
                              <VBox spacing="8.0">
                                 <children>
                                    <Label styleClass="label-bold" text="Statut de la Commande" />
                                    <ComboBox fx:id="statusCb" maxWidth="Infinity" styleClass="combo-box" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" GridPane.columnIndex="1">
                                 <children>
                                    <Label styleClass="label-bold" text="Statut du Paiement" />
                                    <ComboBox fx:id="paymentStatusCb" maxWidth="Infinity" styleClass="combo-box" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>

                        <!-- Shipping Address -->
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="label-bold" text="Adresse de Livraison" />
                              <TextArea fx:id="addressTa" prefHeight="100.0" promptText="Adresse complète de livraison..." styleClass="text-area" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Actions -->
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Button fx:id="submitBtn" maxWidth="Infinity" onAction="#saveSale" styleClass="btn-gradient" text="✓ Finaliser la Vente" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#navigateShowSales" styleClass="btn-reset" text="Annuler" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
