<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.collaboration.Controllers.InvestorController">
    
    <VBox spacing="5">
        <Label styleClass="heading-1" text="Investor Dashboard" />
        <Label styleClass="heading-2" text="Find and Manage Investments" />
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        
        <!-- Browse Projects Tab -->
        <Tab text="Browse Opportunities">
            <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                <Label text="Open Projects Funding Now" style="-fx-font-weight: bold; -fx-text-fill: #2A52BE;" />
                
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <content>
                        <FlowPane fx:id="projectsContainer" hgap="20" vgap="20" style="-fx-padding: 10;" />
                    </content>
                </ScrollPane>
                
                <Button text="Refresh List" styleClass="secondary-button" onAction="#refreshProjects" />
            </VBox>
        </Tab>
        
        <!-- My Portfolio Tab -->
        <Tab text="My Portfolio">
             <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                <TableView fx:id="portfolioTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colInvId" text="Inv ID" prefWidth="60" />
                        <TableColumn fx:id="colInvProject" text="Project ID" prefWidth="100" />
                        <TableColumn fx:id="colInvAmount" text="Invested" prefWidth="120" />
                        <TableColumn fx:id="colInvEquity" text="Equity %" prefWidth="100" />
                        <TableColumn fx:id="colInvStatus" text="Status" prefWidth="120" />
                        <TableColumn fx:id="colInvDate" text="Date" prefWidth="120" />
                        <TableColumn fx:id="colInvAction" text="Actions" prefWidth="180" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                 
                <Button text="Refresh Portfolio" styleClass="secondary-button" onAction="#refreshPortfolio" />
            </VBox>
        </Tab>
        
    </TabPane>
</VBox>
