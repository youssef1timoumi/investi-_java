<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="edu.connections3a8.controllers.QuizController"
      spacing="15" style="-fx-background-color: #f5f5f5;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Title -->
    <Label text="Quiz Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <Separator/>
    
    <!-- Form Fields -->
    <GridPane hgap="10" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="150" prefWidth="150"/>
            <ColumnConstraints minWidth="300" prefWidth="400"/>
        </columnConstraints>
        
        <!-- Title -->
        <Label text="Title:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="titleField" promptText="Enter quiz title" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <!-- Description -->
        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextArea fx:id="descriptionArea" promptText="Enter quiz description" 
                  prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <!-- Points Reward -->
        <Label text="Points Reward:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="pointsRewardField" promptText="100" 
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <!-- Question Count -->
        <Label text="Question Count:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="questionCountField" promptText="10" 
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <!-- Difficulty Level -->
        <Label text="Difficulty:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <ComboBox fx:id="difficultyCombo" promptText="Select difficulty" 
                  GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="200"/>
        
        <!-- Category -->
        <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="categoryField" promptText="programming, database, web..." 
                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        
        <!-- Time Limit -->
        <Label text="Time Limit (sec):" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextField fx:id="timeLimitField" promptText="600" 
                   GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        
        <!-- Passing Score -->
        <Label text="Passing Score (%):" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <TextField fx:id="passingScoreField" promptText="70" 
                   GridPane.columnIndex="1" GridPane.rowIndex="7"/>
        
        <!-- Status -->
        <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
        <ComboBox fx:id="statusCombo" promptText="Select status" 
                  GridPane.columnIndex="1" GridPane.rowIndex="8" prefWidth="200"/>
    </GridPane>
    
    <Separator/>
    
    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Add Quiz" onAction="#handleAddQuiz" 
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;"
                prefWidth="120"/>
        <Button text="Clear Form" onAction="#handleClearForm" 
                style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-size: 14px;"
                prefWidth="120"/>
        <Button text="View All" onAction="#handleViewAll" 
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px;"
                prefWidth="120"/>
    </HBox>
    
    <!-- Status Label -->
    <Label fx:id="statusLabel" style="-fx-font-size: 14px; -fx-text-fill: green;" 
           alignment="CENTER" wrapText="true"/>
    
</VBox>
