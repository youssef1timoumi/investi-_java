<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.connexion3a8.controllers.ForumController"
            styleClass="inv-page-body, forum-page">

    <!-- Forum top toolbar: title + search + Post (headerPane MUST be an HBox to
         match the ForumController field type). -->
    <top>
        <VBox spacing="0">
            <HBox fx:id="headerPane" alignment="CENTER_LEFT" spacing="16"
                  style="-fx-padding: 18 32; -fx-background-color: rgba(255,255,255,0.9); -fx-border-color: rgba(201,185,255,0.3); -fx-border-width: 0 0 1 0;">
                <Label fx:id="homeTitleLabel" text="Community Feed" styleClass="inv-section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Search posts..." styleClass="modern-input" onAction="#handleSearch" prefWidth="320"/>
                <Button text="Post" onAction="#handleCreatePost" styleClass="btn-primary"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 10 32; -fx-background-color: rgba(255,255,255,0.7); -fx-border-color: rgba(201,185,255,0.3); -fx-border-width: 0 0 1 0;">
                <ToggleButton fx:id="allPostsTab"    text="All Posts"  onAction="#handleAllPosts"    styleClass="role-toggle"/>
                <ToggleButton fx:id="myPostsTab"     text="My Posts"   onAction="#handleMyPosts"     styleClass="role-toggle"/>
                <ToggleButton fx:id="myActivityTab"  text="Activity"   onAction="#handleMyActivity"  styleClass="role-toggle"/>
                <ToggleButton fx:id="savedPostsTab"  text="Saved"      onAction="#handleSavedPosts"  styleClass="role-toggle"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Category:" styleClass="label-field"/>
                <ComboBox fx:id="categoryFilter" styleClass="filter-combo" prefWidth="220"/>
            </HBox>
        </VBox>
    </top>

    <!-- Main feed -->
    <center>
        <VBox fx:id="centerPane" styleClass="inv-page-body">
            <!-- Compose Box -->
            <VBox styleClass="compose-box" style="-fx-padding: 18 32;">
                <HBox spacing="12" alignment="TOP_LEFT">
                    <Label fx:id="composeAvatarLabel" text="TU" styleClass="user-avatar"/>
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <TextArea fx:id="composeTextArea" promptText="What's happening?" styleClass="compose-textarea, modern-input" prefRowCount="3"/>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Post" styleClass="btn-primary" onAction="#handleQuickPost"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Posts Feed -->
            <ScrollPane fx:id="feedScroll" fitToWidth="true" styleClass="feed-scroll, inv-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="postsContainer" spacing="14">
                    <padding>
                        <Insets top="16" right="32" bottom="24" left="32"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

    <!-- Hidden legacy controls the controller still binds -->
    <bottom>
        <VBox visible="false" managed="false">
            <VBox fx:id="sidebarPane" visible="false" managed="false"/>
            <Label fx:id="currentUserLabel" text="Test User" visible="false" managed="false"/>
            <Label fx:id="userAvatarLabel" text="TU" visible="false" managed="false"/>
            <ComboBox fx:id="userSelector" visible="false" managed="false"/>
            <Button fx:id="themeToggleBtn" text="" onAction="#handleToggleTheme" visible="false" managed="false"/>
            <Button fx:id="homeButton" text="" onAction="#handleHome" visible="false" managed="false"/>
        </VBox>
    </bottom>
</BorderPane>
