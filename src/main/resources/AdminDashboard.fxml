<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.collaboration.Controllers.AdminController">
    
    <VBox spacing="5">
        <Label styleClass="heading-1" text="Admin Dashboard" />
        <Label styleClass="heading-2" text="System Management" />
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        
        <!-- Tab 1: Validation Queue -->
        <Tab text="Validation Queue">
            <VBox spacing="20" style="-fx-padding: 15;">
                <Label text="Actions Required (Status: UNDER_REVIEW)" style="-fx-font-weight: bold; -fx-text-fill: #e85d04;" />
                
                <!-- Pending Projects -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="New Projects" style="-fx-font-weight: bold;" />
                    <TableView fx:id="projectTableQueue" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colProjectIdQ" text="ID" prefWidth="50" />
                            <TableColumn fx:id="colProjectTitleQ" text="Title" prefWidth="150" />
                            <TableColumn fx:id="colProjectDescQ" text="Description" prefWidth="250" />
                            <TableColumn fx:id="colProjectRepoQ" text="Entrepreneur" prefWidth="100" />
                            <TableColumn fx:id="colProjectStatusQ" text="Status" prefWidth="100" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Reject / Delete" styleClass="button, danger-button" onAction="#deleteProjectQueue" />
                        <Button text="Validate" styleClass="button" onAction="#validateProject" />
                    </HBox>
                </VBox>

                <!-- Pending Investments -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="New Investments" style="-fx-font-weight: bold;" />
                    <TableView fx:id="investmentTableQueue" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colInvIdQ" text="ID" prefWidth="50" />
                            <TableColumn fx:id="colInvProjectQ" text="Project ID" prefWidth="80" />
                            <TableColumn fx:id="colInvInvestorQ" text="Investor ID" prefWidth="80" />
                            <TableColumn fx:id="colInvAmountQ" text="Amount" prefWidth="100" />
                             <TableColumn fx:id="colInvEquityQ" text="Equity %" prefWidth="80" />
                            <TableColumn fx:id="colInvStatusQ" text="Status" prefWidth="100" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Reject / Delete" styleClass="button, danger-button" onAction="#deleteInvestmentQueue" />
                        <Button text="Validate" styleClass="button" onAction="#validateInvestment" />
                    </HBox>
                </VBox>
            </VBox>
        </Tab>
        
        <!-- Tab 2: Project Database -->
        <Tab text="All Projects">
            <VBox spacing="10" style="-fx-padding: 15;">
                 <Label text="Project Database (All Records)" style="-fx-font-weight: bold; -fx-text-fill: #2A52BE;" />
                <TableView fx:id="projectTableAll" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProjectIdAll" text="ID" prefWidth="50" />
                        <TableColumn fx:id="colProjectTitleAll" text="Title" prefWidth="150" />
                        <TableColumn fx:id="colProjectDescAll" text="Description" prefWidth="250" />
                        <TableColumn fx:id="colProjectRepoAll" text="Entrepreneur" prefWidth="100" />
                        <TableColumn fx:id="colProjectStatusAll" text="Status" prefWidth="100" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Delete Permanently" styleClass="button, danger-button" onAction="#deleteProjectAll" />
                </HBox>
            </VBox>
        </Tab>

        <!-- Tab 3: Investment Database -->
        <Tab text="All Investments">
            <VBox spacing="10" style="-fx-padding: 15;">
                <Label text="Investment Database (All Records)" style="-fx-font-weight: bold; -fx-text-fill: #2A52BE;" />
                <TableView fx:id="investmentTableAll" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colInvIdAll" text="ID" prefWidth="50" />
                        <TableColumn fx:id="colInvProjectAll" text="Project ID" prefWidth="80" />
                        <TableColumn fx:id="colInvInvestorAll" text="Investor ID" prefWidth="80" />
                        <TableColumn fx:id="colInvAmountAll" text="Amount" prefWidth="100" />
                        <TableColumn fx:id="colInvEquityAll" text="Equity %" prefWidth="80" />
                        <TableColumn fx:id="colInvStatusAll" text="Status" prefWidth="100" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
                 <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Delete Permanently" styleClass="button, danger-button" onAction="#deleteInvestmentAll" />
                </HBox>
            </VBox>
        </Tab>
        
    </TabPane>
</VBox>
