<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="rootStack" prefHeight="900.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.collaboration.Controllers.EntrepreneurController">
    <stylesheets>
        <URL value="@styles_premium.css" />
    </stylesheets>
    
    <!-- Main Content Layout -->
    <HBox styleClass="main-container">
        <!-- Sidebar -->
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-logo-container">
                <FontIcon iconLiteral="fth-briefcase" styleClass="sidebar-logo" />
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <VBox styleClass="nav-container">
                <Button fx:id="navProjects" onAction="#showProjectsPage" styleClass="nav-btn, active">
                    <graphic>
                        <FontIcon iconLiteral="fth-folder" styleClass="nav-icon" />
                    </graphic>
                    <tooltip><Tooltip text="My Projects" /></tooltip>
                </Button>
                <Button fx:id="navCollaboration" onAction="#showCollaborationPage" styleClass="nav-btn">
                    <graphic>
                        <FontIcon iconLiteral="fth-activity" styleClass="nav-icon" />
                    </graphic>
                    <tooltip><Tooltip text="Collaboration Tracking" /></tooltip>
                </Button>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <VBox styleClass="nav-container">
                <Button styleClass="nav-btn" onAction="#logout">
                    <graphic>
                        <FontIcon iconLiteral="fth-log-out" styleClass="nav-icon" />
                    </graphic>
                    <tooltip><Tooltip text="Logout" /></tooltip>
                </Button>
            </VBox>
        </VBox>

        <!-- Dynamic Content Area -->
        <VBox HBox.hgrow="ALWAYS" styleClass="content-area">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitle" styleClass="title-text" text="Entrepreneur Dashboard" />
                    <Label fx:id="pageSubtitle" styleClass="subtitle-text" text="Manage your projects, evaluate offers via AI, and track progress." />
                </VBox>
            </HBox>

            <VBox spacing="30" VBox.vgrow="ALWAYS">
                <padding><javafx.geometry.Insets top="40" bottom="0" left="0" right="0"/></padding>
                
                <StackPane VBox.vgrow="ALWAYS">
                    
                    <!-- 1. My Projects Page -->
                    <VBox fx:id="projectsPage" spacing="20" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button text="+ Create Project" onAction="#createNewProject" styleClass="add-btn" />
                        </HBox>
                        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                            <FlowPane fx:id="projectsContainer" hgap="30" vgap="30" />
                        </ScrollPane>
                    </VBox>

                    <!-- 2. Offers Page -->
                    <VBox fx:id="offersPage" spacing="20" visible="false" managed="false" VBox.vgrow="ALWAYS">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Button text="← Back to Projects" styleClass="nav-btn" onAction="#showProjectsPage"/>
                            <Label fx:id="offersPageTitle" text="Offers for Project" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -app-primary;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Status:" style="-fx-font-weight: bold; -fx-text-fill: -app-primary;"/>
                            <ComboBox fx:id="statusFilterBox" prefWidth="130" style="-fx-background-radius: 20;"/>
                            <Label text="Sort By:" style="-fx-font-weight: bold; -fx-text-fill: -app-primary;"/>
                            <ComboBox fx:id="sortOffersBox" prefWidth="160" style="-fx-background-radius: 20;"/>
                            <Button text="↺ Refresh" styleClass="nav-btn" onAction="#refreshData"/>
                        </HBox>

                        <TableView fx:id="offersTable" VBox.vgrow="ALWAYS" style="-fx-border-radius: 10; -fx-background-radius: 10;">
                            <columns>
                                <TableColumn fx:id="colOfferId" text="Offer ID" prefWidth="60"/>
                                <TableColumn fx:id="colOfferProject" text="P.ID" prefWidth="50"/>
                                <TableColumn fx:id="colOfferInvestor" text="Investor ID" prefWidth="100"/>
                                <TableColumn fx:id="colOfferAmount" text="Amount (\$)" prefWidth="130"/>
                                <TableColumn fx:id="colOfferEquity" text="Equity (%)" prefWidth="100"/>
                                <TableColumn fx:id="colOfferDuration" text="Duration (Mo)" prefWidth="110"/>
                                <TableColumn fx:id="colOfferStatus" text="Status" prefWidth="120"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        </TableView>
                        
                        <!-- AI Mentor Box for Selected Offer -->
                        <HBox fx:id="aiMentorBox" spacing="15" alignment="CENTER_LEFT" visible="false">
                            <Button fx:id="btnMentor" text="💡 Ask AI Mentor" onAction="#askAiMentor" styleClass="ai-btn" />
                            <Label fx:id="aiMentorAdvice" wrapText="true" style="-fx-font-weight: bold; -fx-text-fill: #9B7E46;" HBox.hgrow="ALWAYS"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAccept" text="✅ Accept Offer" onAction="#acceptOffer" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20;"/>
                            <Button fx:id="btnDecline" text="❌ Decline" onAction="#declineOffer" styleClass="add-btn" style="-fx-background-color: #F44336;"/>
                        </HBox>
                    </VBox>

                    <!-- 3. Collaboration Tracking Page -->
                    <VBox fx:id="collaborationPage" spacing="30" visible="false" managed="false" VBox.vgrow="ALWAYS">
                         <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                            <VBox fx:id="collaborationContainer" spacing="20" />
                        </ScrollPane>
                    </VBox>
                </StackPane>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
