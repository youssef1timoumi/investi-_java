<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.collaboration.Controllers.EntrepreneurController">
    
    <VBox spacing="5">
        <Label styleClass="heading-1" text="Entrepreneur Dashboard" />
        <Label styleClass="heading-2" text="Manage Projects and Offers" />
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        
        <!-- My Projects Tab -->
        <Tab text="My Projects">
            <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                <TableView fx:id="myProjectsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProjId" text="ID" prefWidth="50" />
                        <TableColumn fx:id="colProjTitle" text="Title" prefWidth="150" />
                        <TableColumn fx:id="colProjDesc" text="Description" prefWidth="250" />
                        <TableColumn fx:id="colProjAmount" text="Goal ($)" prefWidth="100" />
                        <TableColumn fx:id="colProjEquity" text="Equity (%)" prefWidth="80" />
                        <TableColumn fx:id="colProjStatus" text="Status" prefWidth="100" />
                        <TableColumn fx:id="colProjAction" text="Actions" prefWidth="180" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Refresh" styleClass="secondary-button" onAction="#refreshData" />
                    <Button text="Create New Project" styleClass="button" onAction="#createNewProject" />
                </HBox>
            </VBox>
        </Tab>
        
        <!-- Offers Tab -->
        <Tab text="Investment Offers">
             <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                <Label text="Project Offers (Pending &amp; Accepted)" style="-fx-font-style: italic; -fx-text-fill: #666;" />
                <TableView fx:id="offersTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colOfferId" text="Inv ID" prefWidth="60" />
                        <TableColumn fx:id="colOfferProject" text="Target Project ID" prefWidth="100" />
                        <TableColumn fx:id="colOfferInvestor" text="Investor ID" prefWidth="80" />
                        <TableColumn fx:id="colOfferAmount" text="Amount Offered" prefWidth="120" />
                        <TableColumn fx:id="colOfferEquity" text="Equity Requested" prefWidth="120" />
                        <TableColumn fx:id="colOfferDuration" text="Duration (Mo)" prefWidth="100" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                 
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Decline" styleClass="button, danger-button" onAction="#declineOffer" />
                    <Button text="Accept Offer" styleClass="button" onAction="#acceptOffer" />
                </HBox>
            </VBox>
        </Tab>
        
    </TabPane>
</VBox>
