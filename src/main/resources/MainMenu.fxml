<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="edu.connections3a8.controllers.MainMenuController"
      spacing="20" alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">
    
    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>
    
    <!-- Title -->
    <Label text="Gamification System" 
           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    
    <Label text="Management Dashboard" 
           style="-fx-font-size: 18px; -fx-text-fill: white;"/>
    
    <Region VBox.vgrow="ALWAYS" minHeight="30"/>
    
    <!-- Menu Buttons -->
    <VBox spacing="15" alignment="CENTER" maxWidth="300">
        <Button text="📚 Manage Courses" onAction="#openCourseForm" 
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 15px;"
                prefWidth="280"/>
        
        <Button text="📝 Manage Quizzes" onAction="#openQuizForm" 
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 15px;"
                prefWidth="280"/>
        
        <Button text="🏆 Manage Badges" onAction="#openBadgeForm" 
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 15px;"
                prefWidth="280"/>
        
        <Button text="👥 View Users" onAction="#openUserView" 
                style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 15px;"
                prefWidth="280"/>
    </VBox>
    
    <Region VBox.vgrow="ALWAYS" minHeight="30"/>
    
    <Label text="© 2024 Gamification System - 3A8" 
           style="-fx-text-fill: white; -fx-font-size: 12px;"/>
    
</VBox>
