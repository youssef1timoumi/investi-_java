<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="edu.connections3a8.controllers.BadgeController"
      spacing="15" style="-fx-background-color: #f5f5f5;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Title -->
    <Label text="Badge Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <Separator/>
    
    <!-- Form Fields -->
    <GridPane hgap="10" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="150" prefWidth="150"/>
            <ColumnConstraints minWidth="300" prefWidth="400"/>
        </columnConstraints>
        
        <!-- Name -->
        <Label text="Badge Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" promptText="Enter badge name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <!-- Description -->
        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextArea fx:id="descriptionArea" promptText="Enter badge description" 
                  prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <!-- Points Required -->
        <Label text="Points Required:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="pointsRequiredField" promptText="0" 
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <!-- Info Label -->
        <Label text="" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label text="💡 Set to 0 for badges earned by actions (not points)" 
               style="-fx-text-fill: #666; -fx-font-size: 11px;"
               GridPane.columnIndex="1" GridPane.rowIndex="3" wrapText="true"/>
    </GridPane>
    
    <Separator/>
    
    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Add Badge" onAction="#handleAddBadge" 
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px;"
                prefWidth="120"/>
        <Button text="Clear Form" onAction="#handleClearForm" 
                style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-size: 14px;"
                prefWidth="120"/>
        <Button text="View All" onAction="#handleViewAll" 
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px;"
                prefWidth="120"/>
    </HBox>
    
    <!-- Status Label -->
    <Label fx:id="statusLabel" style="-fx-font-size: 14px; -fx-text-fill: green;" 
           alignment="CENTER" wrapText="true"/>
    
    <Separator/>
    
    <!-- Badge List -->
    <VBox spacing="10">
        <Label text="Existing Badges" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <ScrollPane fitToWidth="true" prefHeight="200" style="-fx-background-color: white;">
            <VBox fx:id="badgeListContainer" spacing="5" style="-fx-padding: 10;">
                <!-- Badges will be loaded here dynamically -->
            </VBox>
        </ScrollPane>
    </VBox>
    
</VBox>
