<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.connections3a8.controllers.BadgeController"
            fitToWidth="true" fitToHeight="true"
            style="-fx-background-color: transparent;">

<VBox styleClass="root-container"
      stylesheets="@badgesForm.css"
      spacing="20"
      minHeight="1500">

    <padding>
        <Insets top="32" right="36" bottom="32" left="36"/>
    </padding>

    <!-- Title and Theme Toggle -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Badge Management" styleClass="page-title" HBox.hgrow="ALWAYS"/>
        
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="themeToggleBtn" text="🌙 Dark" onAction="#handleThemeToggle"
                    styleClass="btn, btn-secondary"
                    style="-fx-font-size: 12px; -fx-padding: 8 16 8 16;"/>
            <Button fx:id="autoModeBtn" text="⏰ Auto" onAction="#handleAutoMode"
                    styleClass="btn, btn-secondary"
                    style="-fx-font-size: 12px; -fx-padding: 8 16 8 16;"/>
        </HBox>
    </HBox>

    <Separator styleClass="styled-separator"/>

    <!-- Form Fields -->
    <GridPane styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="150" prefWidth="160"/>
            <ColumnConstraints minWidth="300" prefWidth="420" hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Name -->
        <Label text="Badge Name:" styleClass="form-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" promptText="Enter badge name"
                   styleClass="modern-text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <!-- Description -->
        <Label text="Description:" styleClass="form-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextArea fx:id="descriptionArea" promptText="Enter badge description"
                  prefRowCount="3" styleClass="modern-text-area"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <!-- Points Required -->
        <Label text="Points Required:" styleClass="form-label"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="pointsRequiredField" promptText="0"
                   styleClass="modern-text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <!-- Info Label -->
        <Label text="" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label text="Set to 0 for badges earned by actions (not points)"
               styleClass="hint-label" wrapText="true"
               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <Separator styleClass="styled-separator"/>

    <!-- Buttons -->
    <HBox styleClass="button-bar">
        <Button text="Add Badge" onAction="#handleAddBadge"
                styleClass="btn, btn-primary" prefWidth="130"/>
        <Button text="Clear Form" onAction="#handleClearForm"
                styleClass="btn, btn-secondary" prefWidth="130"/>
        <Button text="View All" onAction="#handleViewAll"
                styleClass="btn, btn-secondary" prefWidth="130"/>
        <Button text="Back" onAction="#handleBack"
                styleClass="btn, btn-dark" prefWidth="110"/>
    </HBox>

    <!-- Status Label -->
    <Label fx:id="statusLabel" styleClass="status-label"
           alignment="CENTER" wrapText="true"/>

    <Separator styleClass="styled-separator"/>

    <!-- Badge List -->
    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Existing Badges" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="🔍" style="-fx-font-size: 16px;"/>
        </HBox>

        <!-- Search and Sort Controls -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Search by name or points..."
                       styleClass="modern-text-field"
                       prefWidth="300" HBox.hgrow="ALWAYS"/>
            
            <ComboBox fx:id="sortCombo" promptText="Sort by..."
                      styleClass="modern-combo"
                      prefWidth="180"/>
            
            <Button text="Clear" onAction="#handleClearSearch"
                    styleClass="btn, btn-secondary"
                    style="-fx-font-size: 12px; -fx-padding: 8 16 8 16;"/>
        </HBox>

        <ScrollPane fitToWidth="true" minHeight="600" prefHeight="700" VBox.vgrow="ALWAYS"
                    styleClass="badge-scroll-pane">
            <VBox fx:id="badgeListContainer" styleClass="badge-list-container">
                <!-- Badges will be loaded here dynamically -->
            </VBox>
        </ScrollPane>
    </VBox>

</VBox>

</ScrollPane>
