<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@shadcn.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">
   
   <!-- Sidebar -->
   <left>
      <VBox prefWidth="250.0" styleClass="sidebar">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0">
               <children>
                  <Text fill="#9B7E46" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 28; -fx-font-weight: bold;" text="PIDEV STORE" />
               </children>
            </HBox>
            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="btnProducts" maxWidth="Infinity" mnemonicParsing="false" onAction="#showProducts" styleClass="nav-button, active" text="📁  Products" />
                  <Button fx:id="btnSales" maxWidth="Infinity" mnemonicParsing="false" onAction="#showSales" styleClass="nav-button" text="💰  Sales Tracking" />
                  <Button fx:id="btnAnalytics" maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button" text="📈  Analytics (TBD)" />
               </children>
            </VBox>
            <VBox alignment="BOTTOM_CENTER" prefHeight="100.0" spacing="10.0">
               <children>
                  <Button maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button" text="⚙️  Settings" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button" text="🚪  Logout" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <!-- Search &amp; Content -->
   <center>
      <VBox>
         <children>
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="header">
               <children>
                  <Label fx:id="lblHeader" styleClass="header-title" text="Product Catalog" />
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <TextField promptText="Search everything..." prefWidth="250.0" />
                        <Separator orientation="VERTICAL" prefHeight="30.0" />
                        <Label text="Admin Dashboard" style="-fx-font-weight: bold; -fx-text-fill: #6C757D;" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            
            <!-- Dynamic Content Area -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
               <style>-fx-padding: 30;</style>
            </StackPane>
         </children>
      </VBox>
   </center>
</BorderPane>
