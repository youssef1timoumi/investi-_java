<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.connexion3a8.controllers.EventsPageController"
      styleClass="inv-page-body" spacing="28">
    <padding>
        <Insets top="36" right="48" bottom="56" left="48"/>
    </padding>

    <!-- Page header -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Upcoming Events" styleClass="inv-section-title"/>
            <Label fx:id="userStatusLabel" text="" styleClass="inv-section-subtitle" wrapText="true"/>
        </VBox>
        <Button fx:id="adminManageBtn" text="Manage events" onAction="#handleOpenManagement"
                styleClass="btn-secondary" visible="false" managed="false"/>
    </HBox>

    <!-- Search bar -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="glass-card">
        <TextField fx:id="searchField" promptText="Search events by title, location, or mentor..."
                   styleClass="modern-input" HBox.hgrow="ALWAYS" onKeyReleased="#handleSearch"/>
    </HBox>

    <!-- Events list -->
    <VBox fx:id="eventsContainer" spacing="20"/>

    <!-- Hidden legacy back button so controller can still reference #handleBack if needed -->
    <Button visible="false" managed="false" onAction="#handleBack"/>
</VBox>
