<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.connexion3a8.controllers.gamification.MainMenuController"
            fx:id="mainContainer"
            styleClass="inv-page-body">

    <center>
        <ScrollPane fitToWidth="true" styleClass="inv-scroll" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
            <VBox spacing="0" alignment="TOP_CENTER" styleClass="inv-page-body">

                <!-- Hero Section -->
                <VBox alignment="CENTER" spacing="12" style="-fx-padding: 56 48 48 48; -fx-background-color: linear-gradient(to bottom right, #f7f4ff, #eef3ff, #ecfeff);">
                    <Label text="Learning Center" styleClass="inv-section-title"
                           style="-fx-font-size: 36px; -fx-font-weight: 800;"/>
                    <Label fx:id="subtitleLabel" text="Explore Courses and Quizzes" styleClass="inv-section-subtitle"
                           style="-fx-font-size: 16px; -fx-text-fill: #6b7285;"/>

                    <!-- Stats Row -->
                    <HBox alignment="CENTER" spacing="24" style="-fx-padding: 20 0 0 0;">
                        <VBox alignment="CENTER" spacing="4"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18 28; -fx-effect: dropshadow(gaussian, rgba(124,92,255,0.12), 16, 0, 0, 4); -fx-border-color: #e9e1ff; -fx-border-radius: 14;">
                            <Label text="📚" style="-fx-font-size: 24px;"/>
                            <Label text="Courses" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #7c5cff;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18 28; -fx-effect: dropshadow(gaussian, rgba(34,211,238,0.12), 16, 0, 0, 4); -fx-border-color: #ecfeff; -fx-border-radius: 14;">
                            <Label text="📝" style="-fx-font-size: 24px;"/>
                            <Label text="Quizzes" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #0891b2;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18 28; -fx-effect: dropshadow(gaussian, rgba(124,92,255,0.12), 16, 0, 0, 4); -fx-border-color: #e9e1ff; -fx-border-radius: 14;">
                            <Label text="🏅" style="-fx-font-size: 24px;"/>
                            <Label text="Badges" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #7c5cff;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- User Menu Section -->
                <VBox fx:id="userMenuContainer" spacing="14" alignment="CENTER" maxWidth="480"
                      style="-fx-padding: 32 48 24 48;">
                    <Label text="Start Learning" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1a1c2a;"/>

                    <Button text="📚  Browse Course Catalog" onAction="#openCourseCatalog"
                            prefWidth="420" prefHeight="48"
                            style="-fx-background-color: linear-gradient(to right, #7c5cff, #a78bfa); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 700; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(124,92,255,0.4), 16, 0, 0, 6);"/>

                    <Button text="🏅  My Badges" onAction="#openMyBadges"
                            prefWidth="420" prefHeight="44"
                            style="-fx-background-color: white; -fx-text-fill: #7c5cff; -fx-font-size: 14px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-border-color: #e9e1ff; -fx-border-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);"/>
                </VBox>

                <!-- Admin Menu Section -->
                <VBox fx:id="adminMenuContainer" spacing="14" alignment="CENTER" maxWidth="480"
                      visible="false" managed="false"
                      style="-fx-padding: 8 48 40 48;">

                    <Separator style="-fx-padding: 0 0 8 0;"/>

                    <Label text="⚙️ Admin Tools" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1a1c2a;"/>

                    <HBox spacing="12" alignment="CENTER">
                        <Button text="📚 Courses" onAction="#openCourseForm"
                                prefWidth="130" prefHeight="44"
                                style="-fx-background-color: linear-gradient(to bottom, #7c5cff, #6848ef); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(124,92,255,0.3), 10, 0, 0, 4);"/>
                        <Button text="📝 Quizzes" onAction="#openQuizForm"
                                prefWidth="130" prefHeight="44"
                                style="-fx-background-color: linear-gradient(to bottom, #22d3ee, #0891b2); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(34,211,238,0.3), 10, 0, 0, 4);"/>
                        <Button text="🏅 Badges" onAction="#openBadgeForm"
                                prefWidth="130" prefHeight="44"
                                style="-fx-background-color: white; -fx-text-fill: #7c5cff; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 10; -fx-border-color: #e9e1ff; -fx-border-radius: 10; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Hidden handlers referenced by controller -->
                <Button visible="false" managed="false" onAction="#showMainMenu"/>
                <Button visible="false" managed="false" onAction="#goBackToHome"/>
                <Button visible="false" managed="false" onAction="#openUserView"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
