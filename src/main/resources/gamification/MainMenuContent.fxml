<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="0" alignment="CENTER"
      style="-fx-background-color: linear-gradient(to bottom right, #f7f4ff, #eef3ff, #ecfeff);">

    <padding>
        <Insets top="56" right="48" bottom="48" left="48"/>
    </padding>

    <!-- Hero Title -->
    <Label text="Learning Center"
           style="-fx-font-size: 36px; -fx-font-weight: 800; -fx-text-fill: #1a1c2a; -fx-font-family: 'Inter';"/>

    <Label text="Gamification Management Dashboard"
           style="-fx-font-size: 16px; -fx-text-fill: #6b7285; -fx-padding: 8 0 0 0;"/>

    <!-- Stats Cards -->
    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 36 0 0 0;">
        <VBox alignment="CENTER" spacing="6"
              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24 32; -fx-effect: dropshadow(gaussian, rgba(124,92,255,0.1), 16, 0, 0, 4); -fx-border-color: #e9e1ff; -fx-border-radius: 16;">
            <Label text="📚" style="-fx-font-size: 28px;"/>
            <Label text="Courses" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #7c5cff;"/>
            <Label text="Manage content" style="-fx-font-size: 11px; -fx-text-fill: #6b7285;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="6"
              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24 32; -fx-effect: dropshadow(gaussian, rgba(34,211,238,0.1), 16, 0, 0, 4); -fx-border-color: #ecfeff; -fx-border-radius: 16;">
            <Label text="📝" style="-fx-font-size: 28px;"/>
            <Label text="Quizzes" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #0891b2;"/>
            <Label text="Create assessments" style="-fx-font-size: 11px; -fx-text-fill: #6b7285;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="6"
              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24 32; -fx-effect: dropshadow(gaussian, rgba(124,92,255,0.1), 16, 0, 0, 4); -fx-border-color: #e9e1ff; -fx-border-radius: 16;">
            <Label text="🏅" style="-fx-font-size: 28px;"/>
            <Label text="Badges" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #7c5cff;"/>
            <Label text="Reward achievements" style="-fx-font-size: 11px; -fx-text-fill: #6b7285;"/>
        </VBox>
    </HBox>

    <Region VBox.vgrow="ALWAYS" minHeight="36"/>

    <!-- Menu Buttons -->
    <VBox spacing="12" alignment="CENTER" maxWidth="380">
        <Button fx:id="browseCatalogBtn" text="📚  Browse Course Catalog"
                style="-fx-background-color: linear-gradient(to right, #7c5cff, #a78bfa); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 700; -fx-padding: 14 28; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(124,92,255,0.4), 16, 0, 0, 6);"
                prefWidth="340"/>

        <Separator style="-fx-padding: 4 0; -fx-opacity: 0.3;" prefWidth="340"/>

        <Button fx:id="coursesBtn" text="📚  Manage Courses"
                style="-fx-background-color: linear-gradient(to right, #7c5cff, #6848ef); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand;"
                prefWidth="340"/>

        <Button fx:id="quizzesBtn" text="📝  Manage Quizzes"
                style="-fx-background-color: linear-gradient(to right, #22d3ee, #0891b2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand;"
                prefWidth="340"/>

        <Button fx:id="badgesBtn" text="🏅  Manage Badges"
                style="-fx-background-color: white; -fx-text-fill: #7c5cff; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12 24; -fx-background-radius: 10; -fx-border-color: #e9e1ff; -fx-border-radius: 10; -fx-cursor: hand;"
                prefWidth="340"/>

        <Button fx:id="usersBtn" text="👥  View Users"
                style="-fx-background-color: white; -fx-text-fill: #6b7285; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12 24; -fx-background-radius: 10; -fx-border-color: #e6e8f0; -fx-border-radius: 10; -fx-cursor: hand;"
                prefWidth="340"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS" minHeight="36"/>

    <Label text="© 2024 INVESTI — Learning Center"
           style="-fx-text-fill: #9aa1b4; -fx-font-size: 11px;"/>

</VBox>
