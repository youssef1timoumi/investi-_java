<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.connexion3a8.controllers.gamification.CourseCatalogController"
            fitToWidth="true"
            style="-fx-background-color: transparent;"
            vbarPolicy="AS_NEEDED"
            hbarPolicy="NEVER">

<VBox styleClass="root-container"
      stylesheets="@courseCatalog.css"
      spacing="20">

    <padding>
        <Insets top="0" right="0" bottom="32" left="0"/>
    </padding>

    <!-- Hero Header -->
    <VBox alignment="CENTER" spacing="8"
          style="-fx-padding: 40 36 32 36; -fx-background-color: linear-gradient(to bottom right, #f7f4ff, #eef3ff, #ecfeff);">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <Label text="Course Catalog" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1a1c2a;" HBox.hgrow="ALWAYS"/>
            <Button text="My Badges" onAction="#handleViewBadges"
                    style="-fx-background-color: linear-gradient(to right, #7c5cff, #a78bfa); -fx-text-fill: white; -fx-font-weight: 600; -fx-background-radius: 10; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-size: 13px; -fx-effect: dropshadow(gaussian, rgba(124,92,255,0.3), 10, 0, 0, 3);"/>
            <Button text="History" onAction="#handleViewHistory"
                    style="-fx-background-color: white; -fx-text-fill: #7c5cff; -fx-font-weight: 600; -fx-background-radius: 10; -fx-border-color: #e9e1ff; -fx-border-radius: 10; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-size: 13px;"/>
        </HBox>
    </VBox>

    <!-- Search and Filter -->
    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 36 0 36;">
        <TextField fx:id="searchField" promptText="🔍 Search courses..."
                   styleClass="modern-text-field" prefWidth="280" prefHeight="38"/>

        <ComboBox fx:id="categoryFilter" promptText="All Categories"
                  styleClass="modern-combo" prefWidth="160" prefHeight="38"/>

        <ComboBox fx:id="difficultyFilter" promptText="All Difficulties"
                  styleClass="modern-combo" prefWidth="160" prefHeight="38"/>

        <Button text="✕ Clear" onAction="#handleClearFilters"
                style="-fx-background-color: white; -fx-text-fill: #6b7285; -fx-font-weight: 600; -fx-background-radius: 9999; -fx-border-color: #e6e8f0; -fx-border-radius: 9999; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
    </HBox>

    <!-- Recommendations Section -->
    <VBox fx:id="recommendationsSection" spacing="12" visible="true" managed="true" style="-fx-padding: 0 36 0 36;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="recommendationsTitleLabel" text="✨ Recommended for You"
                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #7c5cff;"/>
            <Label fx:id="recommendationsSubtitleLabel" text="Based on your learning history"
                   style="-fx-font-size: 11px; -fx-text-fill: #6b7285; -fx-font-style: italic;"/>
        </HBox>

        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <HBox fx:id="recommendationsContainer" spacing="14" alignment="CENTER_LEFT">
                <!-- Recommendations loaded dynamically -->
            </HBox>
        </ScrollPane>

        <Separator style="-fx-padding: 8 0 0 0;"/>
    </VBox>

    <!-- Course Count -->
    <Label fx:id="courseCountLabel" text="Loading courses..."
           style="-fx-font-size: 13px; -fx-text-fill: #6b7285; -fx-padding: 0 0 0 36;"/>

    <!-- Course Grid -->
    <GridPane fx:id="courseGrid" hgap="20" vgap="20" VBox.vgrow="ALWAYS" style="-fx-padding: 0 36 0 36;">
        <!-- Courses loaded dynamically -->
    </GridPane>

</VBox>

</ScrollPane>
