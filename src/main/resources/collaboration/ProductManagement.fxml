<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.connexion3a8.controllers.collaboration.ProductManagementController"
      spacing="24" styleClass="inv-page-body">

    <padding>
        <Insets top="32" right="48" bottom="48" left="48"/>
    </padding>

    <!-- Hero header -->
    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="product-hero">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Product Management" styleClass="inv-section-title"/>
            <Label text="Add, edit and track the products available in the INVESTI marketplace."
                   styleClass="inv-section-subtitle" wrapText="true"/>
        </VBox>
        <Button text="Add Product" onAction="#handleAddProduct" styleClass="btn-primary"/>
        <Button text="Refresh"     onAction="#handleRefresh"    styleClass="btn-secondary"/>
    </HBox>

    <!-- Hidden legacy nav handlers kept so the controller still binds -->
    <Button visible="false" managed="false" onAction="#handleGoHome"/>
    <Button visible="false" managed="false" onAction="#handleGoAdminDashboard"/>

    <!-- Catalog card: search + table + actions -->
    <VBox spacing="16" styleClass="glass-card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="14">
            <Label text="Catalog" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search by name, category, or ID..."
                       styleClass="modern-input" prefWidth="320"/>
        </HBox>

        <TableView fx:id="productTable" VBox.vgrow="ALWAYS" styleClass="data-table" prefHeight="420">
            <columns>
                <TableColumn fx:id="colId"       text="ID"       prefWidth="70"/>
                <TableColumn fx:id="colName"     text="Name"     prefWidth="230"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="170"/>
                <TableColumn fx:id="colPrice"    text="Price"    prefWidth="110"/>
                <TableColumn fx:id="colCurrency" text="Currency" prefWidth="110"/>
                <TableColumn fx:id="colStatus"   text="Status"   prefWidth="130"/>
                <TableColumn fx:id="colStock"    text="Stock"    prefWidth="110"/>
                <TableColumn fx:id="colViews"    text="Views"    prefWidth="110"/>
                <TableColumn fx:id="colSales"    text="Sales"    prefWidth="110"/>
            </columns>
        </TableView>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Edit"   onAction="#handleEditProduct"   styleClass="btn-secondary"/>
            <Button text="Delete" onAction="#handleDeleteProduct" styleClass="btn-danger"/>
        </HBox>
    </VBox>

    <!-- Product form -->
    <VBox fx:id="formContainer" spacing="18" styleClass="glass-card">
        <Label text="Product Details" styleClass="section-title"/>

        <GridPane hgap="18" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="22"/>
                <ColumnConstraints percentWidth="78"/>
            </columnConstraints>

            <Label text="Name"        styleClass="label-field" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nameField" promptText="Product name" styleClass="modern-input"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Description" styleClass="label-field" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.valignment="TOP"/>
            <TextArea fx:id="descriptionField" promptText="Product description"
                      prefRowCount="3" wrapText="true" styleClass="modern-input"
                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Price"       styleClass="label-field" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <TextField fx:id="priceField" promptText="0.00" styleClass="modern-input" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="currencyCombo" styleClass="filter-combo" prefWidth="110"/>
            </HBox>

            <Label text="Category"    styleClass="label-field" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <ComboBox fx:id="categoryCombo" editable="true" promptText="Select or type a category"
                          styleClass="filter-combo" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="statusCombo" styleClass="filter-combo" prefWidth="140"/>
            </HBox>

            <Label text="Stock"       styleClass="label-field" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4" alignment="CENTER_LEFT">
                <TextField fx:id="stockField" promptText="0"  styleClass="modern-input" prefWidth="120"/>
                <Label text="Discount (%)" styleClass="label-field"/>
                <TextField fx:id="remiseField" promptText="0" styleClass="modern-input" prefWidth="120"/>
            </HBox>

            <Label text="Type"        styleClass="label-field" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <CheckBox fx:id="digitalCheckBox" text="Digital Product"
                      GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Image"       styleClass="label-field" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="6">
                <TextField fx:id="imageUrlField" promptText="Image URL or path" styleClass="modern-input" HBox.hgrow="ALWAYS"/>
                <Button text="Browse" onAction="#handleBrowseImage" styleClass="btn-secondary"/>
            </HBox>
        </GridPane>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" styleClass="btn-secondary"/>
            <Button fx:id="saveButton"   text="Save"   onAction="#handleSave"   styleClass="btn-primary"/>
        </HBox>
    </VBox>
</VBox>
