<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500" prefWidth="480"
            stylesheets="@Project.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.collaboration.Controllers.Project.AddProjectController">
    <children>
        <VBox alignment="CENTER"
              AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <VBox spacing="14" styleClass="form-container">
                <Label text="Create New Project" styleClass="heading"/>

                <TextField fx:id="titleTf"       promptText="Project Title (min 3 chars)"/>
                <TextField fx:id="descriptionTf" promptText="Description (min 10 chars)"/>

                <!-- Amount + Currency Row -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="amountTf" promptText="Target Amount" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="currencyBox" prefWidth="90"/>
                </HBox>
                <Label fx:id="convertedAmountLabel"
                       style="-fx-text-fill: #2A52BE; -fx-font-size: 12px; -fx-font-style: italic;"/>

                <TextField fx:id="equityTf" promptText="Equity Offered (%)"/>

                <!-- Category -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Category:" style="-fx-text-fill: #444;"/>
                    <ComboBox fx:id="categoryBox" prefWidth="200"/>
                </HBox>

                <Separator/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Cancel" onAction="#goMain" styleClass="secondary"/>
                    <Button text="Submit for Review" onAction="#saveProject"/>
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
