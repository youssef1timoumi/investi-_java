<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600" prefWidth="900" stylesheets="@Project.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.collaboration.Controllers.Project.UpdateProjectController">
    <children>
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <VBox spacing="15.0" styleClass="form-container">
                <Label text="Update Project" styleClass="heading"/>
                
                <TextField fx:id="idTf" promptText="Project ID (to update)" />
                <TextField fx:id="titleTf" promptText="New Title" />
                <TextField fx:id="descTf" promptText="New Description" />
                <TextField fx:id="amountTf" promptText="New Amount" />
                <TextField fx:id="equityTf" promptText="New Equity %" />
                <TextField fx:id="statusTf" promptText="New Status (OPEN, FUNDED, CLOSED)" />
                
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button onAction="#goMain" styleClass="secondary" text="Back" />
                    <Button onAction="#updateProject" text="Update" />
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
