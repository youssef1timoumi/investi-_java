<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.connexion3a8.controllers.LoginController"
           styleClass="auth-background" stylesheets="@styles.css">

    <VBox alignment="CENTER" spacing="22" maxWidth="460" maxHeight="720" styleClass="auth-card">
        <padding>
            <Insets top="32" right="44" bottom="32" left="44"/>
        </padding>

        <!-- Logo -->
        <ImageView fitWidth="120" fitHeight="120" preserveRatio="true" smooth="true" cache="true">
            <Image url="@INVESTI.png"/>
        </ImageView>

        <!-- Title -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="Welcome to INVESTI" styleClass="auth-title"/>
            <Label text="Where innovation meets investment" styleClass="auth-subtitle"/>
        </VBox>

        <!-- Login / Register tabs — same primary color, only one is filled -->
        <HBox spacing="0" alignment="CENTER" maxWidth="Infinity" styleClass="auth-tabs">
            <Button fx:id="loginTabBtn" text="Login" onAction="#switchToLogin"
                    styleClass="auth-tab, auth-tab-active"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="registerTabBtn" text="Register" onAction="#switchToRegister"
                    styleClass="auth-tab"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>

        <!-- Login Form -->
        <VBox fx:id="loginForm" spacing="16" maxWidth="Infinity">
            <VBox spacing="6">
                <Label text="Email" styleClass="label-field"/>
                <TextField fx:id="loginEmail" promptText="your.email@example.com" styleClass="modern-input"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="label-field"/>
                <HBox spacing="0" alignment="CENTER_LEFT">
                    <PasswordField fx:id="loginPassword" promptText="Enter your password" styleClass="modern-input" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="loginPasswordVisible" promptText="Enter your password" styleClass="modern-input" visible="false" managed="false" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="loginPasswordToggle" text="Show" onAction="#toggleLoginPassword"
                            styleClass="auth-eye-btn"/>
                </HBox>
            </VBox>

            <Button fx:id="loginButton" text="Sign in" onAction="#handleLogin"
                    maxWidth="Infinity" styleClass="btn-primary, auth-submit">
                <VBox.margin>
                    <Insets top="6"/>
                </VBox.margin>
            </Button>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="10" maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="4" bottom="4"/>
                </VBox.margin>
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="OR" style="-fx-text-fill: #888; -fx-font-size: 12px;"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Sign in with Google Button -->
            <Button fx:id="googleSignInButton" text="Sign in with Google" onAction="#handleGoogleSignIn"
                    maxWidth="Infinity" styleClass="btn-google">
                <graphic>
                    <Label text="G" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #4285F4; -fx-padding: 4 8; -fx-background-radius: 3;"/>
                </graphic>
            </Button>

            <Label fx:id="loginMessage" styleClass="error-message" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <!-- Register Form -->
        <VBox fx:id="registerForm" spacing="14" maxWidth="Infinity" visible="false" managed="false">
            <VBox spacing="6">
                <Label text="Full name" styleClass="label-field"/>
                <TextField fx:id="registerName" promptText="John Doe" styleClass="modern-input"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Email" styleClass="label-field"/>
                <TextField fx:id="registerEmail" promptText="your.email@example.com" styleClass="modern-input"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="label-field"/>
                <HBox spacing="0" alignment="CENTER_LEFT">
                    <PasswordField fx:id="registerPassword" promptText="Create a strong password" styleClass="modern-input" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="registerPasswordVisible" promptText="Create a strong password" styleClass="modern-input" visible="false" managed="false" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="registerPasswordToggle" text="Show" onAction="#toggleRegisterPassword"
                            styleClass="auth-eye-btn"/>
                </HBox>
                <Label fx:id="passwordStrength" text="" style="-fx-font-size: 11px; -fx-padding: 2 0 0 0;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="I am a" styleClass="label-field"/>
                <HBox spacing="10" alignment="CENTER">
                    <ToggleButton fx:id="innovatorBtn" text="Innovator" selected="true" styleClass="auth-role-toggle"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ToggleButton fx:id="investorBtn" text="Investor" styleClass="auth-role-toggle"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>

            <Button fx:id="registerButton" text="Create account" onAction="#handleRegister"
                    maxWidth="Infinity" styleClass="btn-primary, auth-submit">
                <VBox.margin>
                    <Insets top="6"/>
                </VBox.margin>
            </Button>

            <Label fx:id="registerMessage" styleClass="error-message" wrapText="true" textAlignment="CENTER"/>

            <!-- OTP Verification Section -->
            <VBox fx:id="otpSection" spacing="10" visible="false" managed="false">
                <Label text="Enter the 6-digit code sent to your email" styleClass="auth-otp-hint"/>
                <TextField fx:id="otpField" promptText="000000" styleClass="modern-input, auth-otp-field" alignment="CENTER" maxWidth="Infinity"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="verifyOtpButton" text="Verify" onAction="#handleVerifyOtp" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="resendOtpButton" text="Resend code" onAction="#handleResendOtp" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
